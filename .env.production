# Production environment
NODE_ENV=production

# Database
DATABASE_URL="postgresql://docktor:CHANGE_ME@db:5432/docktor"

# Server
PORT=3000
HOST=0.0.0.0

# Docktor paths (container paths — mapped via docker-compose.yml volumes)
DOCKTOR_BASE_URL=https://docktor.example.com
DOCKTOR_STACKS_DIR=/stacks
DOCKTOR_DATA_DIR=/data
DOCKTOR_BACKUP_DIR=/backups

# Client dist path
CLIENT_DIST_PATH=./client-dist

# Auth (better-auth)
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
BETTER_AUTH_URL=https://docktor.example.com
