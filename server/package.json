{
    "name": "@docktor/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "dotenv -e ../.env.development -- tsx watch src/index.ts",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project test/integration"
    },
    "dependencies": {
        "@docktor/shared": "workspace:*",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^10.0.2",
        "@fastify/static": "^8.1.0",
        "chokidar": "^4.0.3",
        "dockerode": "^4.0.4",
        "fast-glob": "^3.3.3",
        "fastify": "^5.2.1",
        "fastify-type-provider-zod": "^6.1.0",
        "node-cron": "^3.0.3",
        "nodemailer": "^8.0.2",
        "yaml": "^2.7.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "^11.12.0",
        "@types/dockerode": "^3.3.35",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^7.0.11",
        "@types/semver": "^7.7.1",
        "pino-pretty": "^13.1.3",
        "testcontainers": "^11.12.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^4.0.18"
    }
}
