model Backup {
  id      String @id @default(cuid())
  stackId String
  stack   Stack  @relation(fields: [stackId], references: [id], onDelete: Cascade)

  resticSnapshotId String // restic snapshot ID
  sizeBytes        BigInt?
  trigger          BackupTrigger // manual, scheduled, or restore
  status           BackupStatus
  errorMessage     String?
  logLines         String[] // stored restic output lines for detail page

  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime @default(now())
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
  RESTORE
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}
