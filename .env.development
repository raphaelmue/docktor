# Development environment
NODE_ENV=development

# Database (Postgres via docker-compose.dev.yml)
DATABASE_URL="postgresql://docktor:docktor@localhost:5432/docktor"

# Server
PORT=3000
HOST=0.0.0.0

# Docktor paths (local dev — relative paths)
DOCKTOR_BASE_URL=http://localhost:5173
DOCKTOR_STACKS_DIR=./dev-data/stacks
DOCKTOR_DATA_DIR=./dev-data/data
DOCKTOR_BACKUP_DIR=./dev-data/backups

# Auth (better-auth)
BETTER_AUTH_SECRET=dev-secret-change-me-in-production
BETTER_AUTH_URL=http://localhost:5173
