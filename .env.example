# Docktor environment configuration — docker-compose deployment template.
#
# Copy this file to `.env.local` (the file docker-compose.yml's `env_file`
# entry loads) and change every value marked CHANGE_ME before running
# `docker compose up`. See docs/deployment.md for the full quickstart,
# the complete variable reference, and a troubleshooting guide mapped to
# the exact mistakes people have already made with this file.

# ─── Server ──────────────────────────────────────────────────────────────

# Required. Must be exactly "production" for a docker-compose deployment —
# this is the switch that turns on serving the built React SPA
# (server/src/app.ts). Any other value makes the instance look like a
# backend-only install with no frontend, with no error to explain why.
NODE_ENV=production

# Optional, defaults to 3000. Port the Fastify server listens on inside the
# container. Only change this if you also change the published port in
# docker-compose.yml's `ports:` entry.
PORT=3000

# Optional, defaults to 0.0.0.0 (all interfaces). Leave this as-is for the
# docker-compose deployment.
HOST=0.0.0.0

# Optional. Path to the built client SPA, used only when NODE_ENV=production.
# The Dockerfile's image layout already resolves the correct default
# (./client-dist) — you should not need to set this for docker-compose.
# CLIENT_DIST_PATH=./client-dist

# ─── Database ────────────────────────────────────────────────────────────

# Required. Postgres connection string. The host "db" is the docker-compose
# service name for the bundled Postgres container, not a real hostname —
# leave it as "db" unless you point this at an external database. Change
# the password here AND in docker-compose.yml's `db.environment` before any
# real deployment; the values must match on both sides.
DATABASE_URL="postgresql://docktor:CHANGE_ME_DB_PASSWORD@db:5432/docktor"

# Optional, defaults to true. Applies the Prisma schema automatically at
# container startup (a guarded `prisma db push`, not `prisma migrate` — a
# deliberate interim step; see docs/deployment.md and
# .planning/todos/pending/2026-09-01-adopt-prisma-migrate-post-mvp.md). Set
# to "false" once you manage the schema yourself.
# DOCKTOR_DB_AUTO_PUSH=false

# ─── Authentication (better-auth) ───────────────────────────────────────

# REQUIRED. Signing secret for sessions — the server crashes at boot with an
# unhelpful BetterAuthError if this is missing. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CHANGE_ME before any real deployment.
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# REQUIRED for any real deployment. The externally-reachable URL of this
# Docktor instance (e.g. https://docktor.example.com, or
# http://<server-ip>:3000 for a plain self-host with no reverse proxy).
# This is the variable that actually matters for login: it feeds both
# better-auth's `baseURL` AND its `trustedOrigins`. Getting it wrong does
# not crash the server — it produces an "invalid origin" login failure that
# looks completely unrelated to this variable.
BETTER_AUTH_URL=http://localhost:3000

# ─── Encryption ──────────────────────────────────────────────────────────

# REQUIRED, and MUST be exactly 64 hex characters (32 bytes) — every
# encrypt/decrypt call throws otherwise. Encrypts SMTP passwords, SFTP keys,
# S3 secrets, and the restic repository password at rest
# (server/src/lib/crypto.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CHANGE_ME before any real deployment — a shared or default key makes
# every secret it protects recoverable by anyone who has this value.
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_HEX_KEY

# ─── Stacks directory (Docker-outside-of-Docker) ────────────────────────
#
# THIS PAIR MUST STAY IDENTICAL. Docktor drives the HOST's Docker daemon
# over a mounted socket (Docker-outside-of-Docker): any relative bind mount
# declared in a managed stack's compose file is resolved against
# DOCKTOR_STACKS_DIR (this container's own filesystem view), and that
# resolved absolute path is then sent to the HOST daemon as-is. If
# DOCKTOR_STACKS_HOST_DIR (the real host-side path) does not match, the
# host daemon silently writes to a path that does not exist there, and
# that data is lost the next time the container is recreated. Both
# variables below are wired into docker-compose.yml's stacks volume — set
# DOCKTOR_STACKS_HOST_DIR to relocate the stacks directory; you do not
# need to edit docker-compose.yml itself. See docs/deployment.md.

# Container-side path (docker-compose volume target). Do not change unless
# you also change the volume target in docker-compose.yml.
DOCKTOR_STACKS_DIR=/opt/docktor/stacks
# Host-side path (docker-compose volume source) — where managed stacks
# actually live on this machine's disk. Must equal DOCKTOR_STACKS_DIR above.
DOCKTOR_STACKS_HOST_DIR=/opt/docktor/stacks

# Host-run alternative (no Docker, i.e. `yarn dev`): comment out the two
# live lines above and use a plain relative path instead.
# DOCKTOR_STACKS_HOST_DIR only applies to Docker-outside-of-Docker and must
# stay unset when running directly on the host.
# DOCKTOR_STACKS_DIR=./dev-data/stacks

# Optional. Forces the stacks-directory file watcher into polling mode
# instead of native inotify. Auto-detected off unless the container's own
# platform is Windows (which it never is, since this always runs on Linux
# inside the image) — but Docker Desktop's virtualized bind mounts on
# Windows/Mac hosts don't propagate inotify events into a Linux container
# either. Set this explicitly if external compose edits stop being detected.
# DOCKTOR_FS_POLLING=true

# ─── Disk monitoring ─────────────────────────────────────────────────────

# Optional, defaults to /var/lib/docker on Linux — but that default is
# WRONG for this docker-compose deployment: it would measure this
# container's own small, throwaway filesystem layer, not the host's real
# disk. docker-compose.yml mounts the host's root filesystem read-only at
# /host specifically so this check can see real host disk usage — leave
# this pointed at that mount unless your Docker data-root lives somewhere
# other than /var/lib/docker on the host.
DOCKER_DATA_PATH=/host/var/lib/docker

# ─── Backups (restic) ────────────────────────────────────────────────────

# Optional, defaults to "restic" (resolved via PATH). The Dockerfile
# installs a pinned, checksum-verified restic release at
# /usr/local/bin/restic, already on PATH — you should not need to set this.
# RESTIC_BINARY=/usr/local/bin/restic
