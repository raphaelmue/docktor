# Database (PostgreSQL)
DATABASE_URL="postgresql://docktor:docktor@localhost:5432/docktor"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Docktor paths
DOCKTOR_BASE_URL=http://localhost:5173
DOCKTOR_STACKS_DIR=./dev-data/stacks
DOCKTOR_DATA_DIR=./dev-data/data
DOCKTOR_BACKUP_DIR=./dev-data/backups

# Client dist path (production only)
# CLIENT_DIST_PATH=./client-dist

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:5173
