# Database (PostgreSQL)
DATABASE_URL="postgresql://docktor:docktor@localhost:5432/docktor"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Docktor paths
DOCKTOR_BASE_URL=http://localhost:5173
DOCKTOR_STACKS_DIR=./dev-data/stacks
DOCKTOR_DATA_DIR=./dev-data/data
DOCKTOR_BACKUP_DIR=./dev-data/backups

# Docker data path for disk monitoring (optional)
# Linux default: /var/lib/docker
# Windows default: . (current directory)
# DOCKER_DATA_PATH=/var/lib/docker

# Client dist path (production only)
# CLIENT_DIST_PATH=./client-dist

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:5173

# Encryption key for sensitive data (32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
