{
  "name": "docktor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "prisma generate --schema=src/lib/db/schema",
    "db:push": "prisma db push --schema=src/lib/db/schema",
    "db:migrate": "prisma migrate dev --schema=src/lib/db/schema",
    "db:studio": "prisma studio --schema=src/lib/db/schema"
  },
  "prisma": {
    "schema": "src/lib/db/schema"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  }
}
